# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit file .env ke git!

# Koneksi ke database PostgreSQL (Supabase)
# Isi dari Dashboard Supabase -> Project Settings -> Database -> Connection string (URI)
# Jika dikosongkan, aplikasi memakai SQLite lokal.
DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@db.PROYEK-ANDA.supabase.co:5432/postgres

# Opsional: hanya dipakai backend (server.js). Login admin web memakai Supabase Auth,
# sehingga cukup buat user admin di Dashboard Supabase -> Authentication -> Users.
ADMIN_PASSWORD=
